# Clave criptográfica de Django. Usa un valor largo, aleatorio y secreto en producción.
SECRET_KEY=cambia-esta-clave-en-produccion

# Activa las ayudas de desarrollo de Django. Usa False en producción.
DEBUG=True

# Hosts que pueden servir la API, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Clave de la API de Anthropic usada para generar las lecturas.
ANTHROPIC_API_KEY=
# Clave opcional sk-ant-admin para conciliar costos de organizaciones.
ANTHROPIC_ADMIN_API_KEY=

# Identificador concreto del modelo de Anthropic que generará las lecturas.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Tiempo máximo, en segundos, de cada llamada a Anthropic.
ANTHROPIC_TIMEOUT=30

# Temperatura opcional; si se omite, Anthropic usa su valor predeterminado 1.0.
# No configures un valor distinto de 1.0 con modelos de generación 5.
# ANTHROPIC_TEMPERATURE=1.0

# Proxy HTTPS opcional (necesario en cuentas gratuitas de PythonAnywhere).
# ANTHROPIC_PROXY=http://proxy.server:3128

# Freno mensual en la misma moneda de ModelPricing. 0 desactiva el límite.
MONTHLY_BUDGET=0
# Avisa en el panel cuando el saldo local estimado baja de este valor (USD).
LOW_BALANCE_THRESHOLD=0

# Promoción temporal: al activarla, toda concesión requiere una fecha de vencimiento ISO.
TRIAL_MODE=False
# TRIAL_ENDS_AT=2026-10-10T23:59:59-03:00

# URL de PostgreSQL. Déjala vacía para usar SQLite durante el desarrollo.
DATABASE_URL=

# Orígenes autorizados para llamar a la API desde el navegador, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Orígenes confiables para solicitudes protegidas por CSRF, separados por comas.
CSRF_TRUSTED_ORIGINS=http://localhost:5173
